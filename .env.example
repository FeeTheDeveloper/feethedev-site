NEXT_PUBLIC_SITE_URL=https://feethedeveloper.com
NEXT_PUBLIC_BOOKING_URL=https://calendar.app.google/your-booking-page
NEXT_PUBLIC_DEPOSIT_URL=https://buy.stripe.com/4gMaEX9u80iagNt5q31RC02
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
# Server-only. Lets /api/intake write project intakes to public.project_intakes.
# Store as a Cloudflare Worker secret (wrangler secret put SUPABASE_SECRET_KEY); never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_COMMUNITY_URL=
# Merch checkout. Each value is a JSON map of color slug -> Stripe Payment Link,
# printed by `npm run merch:links -- --apply`. A single buy.stripe.com URL also
# works and is then used for every color. Anything else falls back to the
# inquiry button. Color slugs: white, heather-gray, royal-blue, vivid-red,
# sage-green.
# Example: MERCH_HAT_STRIPE_LINK={"white":"https://buy.stripe.com/aaa","sage-green":"https://buy.stripe.com/bbb"}
MERCH_HOODIE_STRIPE_LINK=
MERCH_JOGGERS_STRIPE_LINK=
MERCH_TSHIRT_STRIPE_LINK=
MERCH_HAT_STRIPE_LINK=
